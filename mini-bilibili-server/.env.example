# Local application port
SERVER_PORT=8084

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mini_bili
DB_USERNAME=mini_bili
DB_PASSWORD=replace-with-a-strong-app-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=9000000
REFRESH_TOKEN_EXPIRE=604800000
COOKIE_SECURE=false

# Database migrations. Keep false for an existing database until verified.
FLYWAY_ENABLED=false

# Alibaba Cloud OSS/CDN. Use a RAM user with least-privilege permissions.
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=replace-with-your-bucket
OSS_PUBLIC_DOMAIN=https://media.example.com
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
