# Local host ports. Containers communicate through their service names and internal ports.
WEB_PORT=8080
ADMIN_PORT=8081
SERVER_HOST_PORT=8084
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=mini_bili
DB_USERNAME=mini_bili
DB_PASSWORD=replace-with-a-strong-app-password
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DATABASE=0

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=9000000
REFRESH_TOKEN_EXPIRE=604800000

# Keep false for local HTTP. Set true after production HTTPS is available.
COOKIE_SECURE=false

# Existing databases should keep this false until the Flyway baseline is verified.
# A brand-new empty database can be tested with true.
FLYWAY_ENABLED=false

# Upload limits
MAX_FILE_SIZE=500MB
MAX_REQUEST_SIZE=500MB

# Alibaba Cloud OSS. Never commit real credentials.
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=mini-bili
OSS_PUBLIC_DOMAIN=https://media.example.com
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret

# Used only by the optional production Caddy gateway.
WEB_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
